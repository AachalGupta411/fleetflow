# Copy this file to backend/.env and replace the placeholders.
# Never commit backend/.env.

# SQLAlchemy URL. Use the psycopg (v3) driver.
# Example for local Homebrew PostgreSQL with a passwordless OS user:
# postgresql+psycopg://YOUR_OS_USER@localhost:5432/fleetflow
APP_ENV=development
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/fleetflow

# Secret used to sign JWT access tokens. Use a long random value.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=720

# Comma-separated browser origins allowed to call the API.
# The Android app does not send an Origin header; this matters for Flutter web.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8080,http://localhost:8080

# Optional. Server-side routing and geocoding. Set at most one of these.
# OpenRouteService is free and needs no card: https://openrouteservice.org
# When both are set, OpenRouteService is used.
# Do not put either key in the Flutter app.
OPENROUTE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Arrival radius in meters. The API rejects an arrival outside this distance.
GEOFENCE_RADIUS_METERS=100

# local stores proof files on this machine. supabase uses the values below.
# Leave supabase blank until you have a project. Do not commit the service role key.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fleetflow-pod

# Path to a Firebase service account JSON. Leave empty until push delivery is configured.
# The file must stay outside Git. Without it, alerts are stored in the app and push_sent stays false.
FIREBASE_CREDENTIALS_FILE=
